# Pramana Environment Configuration Example
# Copy to .env and fill only what you need. Do not commit real secrets.

# --- AI provider ---
# required: no silent template fallback for user-facing AI output.
# optional: deterministic fallback allowed for local development/tests.
# disabled: skip AI calls (retrieval-only evaluation).
AI_MODE=optional
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
# Verify the current Gemini embedding model before building embeddings.
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# --- Public URL used in copied WhatsApp text ---
# Optional. Example: https://your-pramana.example.com
PRAMANA_PUBLIC_URL=

# --- API security ---
# Comma-separated browser origins allowed to call the API.
CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Sliding-window rate limit for POST endpoints (per client, per process).
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=60

# Maximum accepted request body size in bytes (checked via Content-Length).
MAX_REQUEST_BODY_BYTES=65536

# Only enable when running behind a trusted reverse proxy that overwrites
# X-Forwarded-For. Enabling this on a direct-to-internet server lets clients
# spoof their IP and bypass the rate limiter.
TRUST_PROXY_HEADERS=false
